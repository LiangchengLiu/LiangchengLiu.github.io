  author={Liu, Liangcheng and Zhuang, Zijian and Chen, Liangming and Almuzakki, Muhammad Zaki},
  abstract={This paper investigates the modeling and control of four rigidly connected quadrotor UAVs (FRCQU) system. A dynamic model based on Euler&ndash;Lagrange theory is established, in which the overall system is treated as a single rigid body to accurately capture the coupled translational and rotational dynamics. To achieve stable and coordinated ﬂight, a cascaded PD control architecture is developed for the system. The proposed framework ensures desired motion and robust stability under rigid-body constraints. The simulation results validate its effectiveness in achieving rapid convergence of position errors and coordinated rotor-level response.},
